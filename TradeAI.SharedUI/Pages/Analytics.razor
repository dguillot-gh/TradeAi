@page "/analytics"
@inject HttpClient Http

<PageTitle>AI Analytics</PageTitle>

<div style="margin-bottom: 2rem;">
    <h1 style="margin-bottom: 0.5rem;">Performance Analytics</h1>
    <p>Track how well the AI's suggestions have performed over time.</p>
</div>

@if (isLoading)
{
    <div style="text-align: center; padding: 3rem; color: var(--text-secondary);">
        <div style="display: inline-block; width: 32px; height: 32px; border: 3px solid var(--text-secondary); border-top-color: var(--accent-primary); border-radius: 50%; animation: spin 1s linear infinite; margin-bottom: 1rem;"></div>
        <p>Loading performance metrics...</p>
    </div>
}
else if (performanceData != null)
{
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
        
        <!-- Theoretical Performance (All Picks) -->
        <div class="glass-panel" style="padding: 1.5rem;">
            <h2 style="margin-bottom: 1rem; display: flex; align-items: center; justify-content: space-between;">
                Theoretical Performance
                <span style="font-size: 0.8rem; font-weight: normal; color: var(--text-secondary);">All Picks</span>
            </h2>
            <div style="display: flex; gap: 2rem;">
                <div>
                    <div style="color: var(--text-secondary); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.25rem;">Win Rate</div>
                    <div style="font-size: 2rem; font-weight: bold; color: @(performanceData.theoretical.win_rate >= 50 ? "var(--accent-success)" : "var(--accent-danger)");">
                        @performanceData.theoretical.win_rate%
                    </div>
                </div>
                <div>
                    <div style="color: var(--text-secondary); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.25rem;">Avg Return</div>
                    <div style="font-size: 2rem; font-weight: bold; color: @(performanceData.theoretical.average_return >= 0 ? "var(--accent-success)" : "var(--accent-danger)");">
                        @(performanceData.theoretical.average_return >= 0 ? "+" : "")@performanceData.theoretical.average_return%
                    </div>
                </div>
            </div>
            <div style="margin-top: 1rem; color: var(--text-secondary); font-size: 0.85rem;">
                Based on @performanceData.theoretical.total_trades total AI suggestions.
            </div>
        </div>

        <!-- Actual Performance (Your Trades) -->
        <div class="glass-panel" style="padding: 1.5rem; border: 1px solid rgba(59, 130, 246, 0.3);">
            <h2 style="margin-bottom: 1rem; display: flex; align-items: center; justify-content: space-between;">
                Actual Performance
                <span style="font-size: 0.8rem; font-weight: normal; color: var(--text-secondary); background: rgba(59, 130, 246, 0.2); color: #60a5fa; padding: 0.2rem 0.5rem; border-radius: 4px;">Actioned Trades</span>
            </h2>
            @if (performanceData.actual.total_trades > 0)
            {
                <div style="display: flex; gap: 2rem;">
                    <div>
                        <div style="color: var(--text-secondary); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.25rem;">Win Rate</div>
                        <div style="font-size: 2rem; font-weight: bold; color: @(performanceData.actual.win_rate >= 50 ? "var(--accent-success)" : "var(--accent-danger)");">
                            @performanceData.actual.win_rate%
                        </div>
                    </div>
                    <div>
                        <div style="color: var(--text-secondary); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.25rem;">Avg Return</div>
                        <div style="font-size: 2rem; font-weight: bold; color: @(performanceData.actual.average_return >= 0 ? "var(--accent-success)" : "var(--accent-danger)");">
                            @(performanceData.actual.average_return >= 0 ? "+" : "")@performanceData.actual.average_return%
                        </div>
                    </div>
                </div>
                <div style="margin-top: 1rem; color: var(--text-secondary); font-size: 0.85rem;">
                    Based on the @performanceData.actual.total_trades trades you executed.
                </div>
            }
            else
            {
                <div style="display: flex; height: 100%; align-items: center; color: var(--text-secondary);">
                    You haven't marked any trades as executed yet.
                </div>
            }
        </div>
    </div>

    <div class="glass-panel" style="padding: 1.5rem;">
        <h2 style="margin-bottom: 1.5rem;">Trade Ledger</h2>
        
        @if (performanceData.ledger != null && performanceData.ledger.Any())
        {
            <div style="overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse; text-align: left;">
                    <thead>
                        <tr style="border-bottom: 1px solid var(--border-color); color: var(--text-secondary); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em;">
                            <th style="padding: 1rem 0.5rem; font-weight: 500;">Date</th>
                            <th style="padding: 1rem 0.5rem; font-weight: 500;">Action</th>
                            <th style="padding: 1rem 0.5rem; font-weight: 500;">Symbol</th>
                            <th style="padding: 1rem 0.5rem; font-weight: 500;">Start Price</th>
                            <th style="padding: 1rem 0.5rem; font-weight: 500;">Current Price</th>
                            <th style="padding: 1rem 0.5rem; font-weight: 500; text-align: right;">Return</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var trade in performanceData.ledger)
                        {
                            var rowBg = trade.is_actioned ? "rgba(59, 130, 246, 0.05)" : "transparent";
                            var retColor = trade.return_percent >= 0 ? "var(--accent-success)" : "var(--accent-danger)";
                            var actionColor = trade.action.ToLower() == "buy" ? "var(--accent-success)" : "var(--accent-danger)";
                            
                            <tr style="border-bottom: 1px solid var(--border-color); background: @rowBg;">
                                <td style="padding: 1rem 0.5rem; font-size: 0.9rem; color: var(--text-secondary);">
                                    @FormatDate(trade.generated_at)
                                </td>
                                <td style="padding: 1rem 0.5rem;">
                                    <span style="background: @actionColor; color: white; padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.8rem;">
                                        @trade.action
                                    </span>
                                </td>
                                <td style="padding: 1rem 0.5rem; font-weight: bold;">
                                    @trade.symbol
                                    @if (trade.is_actioned)
                                    {
                                        <span style="font-size: 0.7rem; color: #60a5fa; margin-left: 0.5rem;">✓ Actioned</span>
                                    }
                                </td>
                                <td style="padding: 1rem 0.5rem;">$@trade.suggested_price?.ToString("N2")</td>
                                <td style="padding: 1rem 0.5rem;">$@trade.current_price?.ToString("N2")</td>
                                <td style="padding: 1rem 0.5rem; text-align: right; font-weight: bold; color: @retColor;">
                                    @(trade.return_percent >= 0 ? "+" : "")@trade.return_percent%
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div style="text-align: center; padding: 2rem; color: var(--text-secondary);">
                No historical trade data available yet.
            </div>
        }
    </div>
}
else
{
    <div style="text-align: center; padding: 2rem; color: var(--accent-danger);">
        Failed to load performance metrics.
    </div>
}

<style>
    @@keyframes spin {
        to { transform: rotate(360deg); }
    }
</style>

@code {
    private bool isLoading = true;
    private PerformanceResponse? performanceData;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            performanceData = await Http.GetFromJsonAsync<PerformanceResponse>("/analytics/performance");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading analytics: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private string FormatDate(string? isoDate)
    {
        if (string.IsNullOrEmpty(isoDate)) return "";
        if (DateTimeOffset.TryParse(isoDate, out var date))
        {
            return date.ToLocalTime().ToString("MMM dd, yyyy");
        }
        return isoDate;
    }

    public class PerformanceResponse
    {
        public Stats theoretical { get; set; } = new();
        public Stats actual { get; set; } = new();
        public List<LedgerItem> ledger { get; set; } = new();
    }

    public class Stats
    {
        public decimal win_rate { get; set; }
        public decimal average_return { get; set; }
        public int total_trades { get; set; }
    }

    public class LedgerItem
    {
        public int id { get; set; }
        public string symbol { get; set; } = "";
        public string action { get; set; } = "";
        public decimal? suggested_price { get; set; }
        public decimal? current_price { get; set; }
        public decimal return_percent { get; set; }
        public bool is_actioned { get; set; }
        public string generated_at { get; set; } = "";
    }
}
