@page "/advisor"

@inject HttpClient Http

<PageTitle>AI Trade Advisor</PageTitle>

<div style="display: flex; flex-direction: column; height: 100%; max-height: calc(100vh - 4rem);">
    <div style="margin-bottom: 1.5rem;">
        <h1 style="margin-bottom: 0.5rem;">AI Advisor</h1>
        <p>Chat with your Gemini-powered financial assistant to analyze the market.</p>
    </div>

    <div class="glass-panel" style="flex: 1; display: flex; flex-direction: column; overflow: hidden;">
        <!-- Chat History -->
        <div style="flex: 1; overflow-y: auto; padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
            @foreach (var msg in messages)
            {
                if (msg.IsUser)
                {
                    <div style="display: flex; gap: 1rem; align-items: flex-start; align-self: flex-end; flex-direction: row-reverse;">
                        <div style="width: 40px; height: 40px; border-radius: 50%; background: var(--bg-surface-hover); display: flex; align-items: center; justify-content: center; font-weight: bold; flex-shrink: 0; border: 1px solid var(--border-color);">
                            U
                        </div>
                        <div style="background: var(--accent-primary); padding: 1rem; border-radius: var(--radius-md) 0 var(--radius-md) var(--radius-md); max-width: 80%;">
                            <p style="margin: 0; color: white;">@msg.Text</p>
                        </div>
                    </div>
                }
                else
                {
                    <div style="display: flex; gap: 1rem; align-items: flex-start;">
                        <div style="width: 40px; height: 40px; border-radius: 50%; background: var(--accent-success); display: flex; align-items: center; justify-content: center; font-weight: bold; flex-shrink: 0;">
                            AI
                        </div>
                        <div style="background: rgba(15, 23, 42, 0.6); padding: 1rem; border-radius: 0 var(--radius-md) var(--radius-md) var(--radius-md); border: 1px solid var(--border-color); max-width: 80%;">
                            <p style="margin: 0; color: var(--text-primary); white-space: pre-wrap;">@msg.Text</p>
                        </div>
                    </div>
                }
            }
            
            @if (isTyping)
            {
                <div style="display: flex; gap: 1rem; align-items: flex-start;">
                    <div style="width: 40px; height: 40px; border-radius: 50%; background: var(--accent-success); display: flex; align-items: center; justify-content: center; font-weight: bold; flex-shrink: 0;">
                        AI
                    </div>
                    <div style="background: rgba(15, 23, 42, 0.6); padding: 1rem; border-radius: 0 var(--radius-md) var(--radius-md) var(--radius-md); border: 1px solid var(--border-color); max-width: 80%;">
                        <p style="margin: 0; color: var(--text-secondary); font-style: italic;">Thinking...</p>
                    </div>
                </div>
            }
        </div>

        <!-- Chat Input -->
        <div style="padding: 1.5rem; border-top: 1px solid var(--border-color); background: rgba(15, 23, 42, 0.3);">
            <form style="display: flex; gap: 1rem;" @onsubmit="SendMessage">
                <input type="text" class="input-field" placeholder="Ask about stocks, market conditions, or your portfolio..." @bind="userInput" disabled="@isTyping" />
                <button type="submit" class="btn btn-primary" style="padding: 0 2rem;" disabled="@(string.IsNullOrWhiteSpace(userInput) || isTyping)">Send</button>
            </form>
        </div>
    </div>
</div>

@code {
    private string userInput = "";
    private bool isTyping = false;
    private List<ChatMessage> messages = new()
    {
        new ChatMessage { IsUser = false, Text = "Hello! I'm your TradeAI Advisor. I've analyzed your portfolio. How can I help you today? You can ask me about market trends, specific stocks, or for trade suggestions." }
    };

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(userInput)) return;

        var text = userInput;
        userInput = "";
        messages.Add(new ChatMessage { IsUser = true, Text = text });
        isTyping = true;
        StateHasChanged();

        try
        {
            var response = await Http.PostAsJsonAsync("/ai/chat", new { message = text });
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ChatResponse>();
                messages.Add(new ChatMessage { IsUser = false, Text = result?.reply ?? "I couldn't process that." });
            }
            else
            {
                messages.Add(new ChatMessage { IsUser = false, Text = "Sorry, I am having trouble connecting to my servers right now." });
            }
        }
        catch (Exception ex)
        {
            messages.Add(new ChatMessage { IsUser = false, Text = $"Error: {ex.Message}" });
        }
        finally
        {
            isTyping = false;
            StateHasChanged();
        }
    }

    public class ChatMessage
    {
        public bool IsUser { get; set; }
        public string Text { get; set; }
    }

    public class ChatResponse
    {
        public string reply { get; set; }
    }
}
